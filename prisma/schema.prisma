// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  clerkId       String     @unique
  email         String     @unique
  name          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
  scripts       Script[]
  projects      Project[]
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     // active, archived, etc.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  type        String   // direct-mail, cold-calling, driving-for-dollars, social-media
  targetArea  String   // distressed, vacant, inheritance, divorce, tax-delinquent, probate
  status      String   // active, pending, completed
  description String
  sent        Int?     // For direct mail
  calls       Int?     // For cold calling
  properties  Int?     // For driving for dollars
  responses   Int
  leads       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scripts     Script[]
}

model Script {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
} 